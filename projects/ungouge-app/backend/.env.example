# =============================================================================
# Ungouge.ai Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ---------- Core ----------
# Environment: "development" or "production"
# Controls HTTPS redirect, HSTS headers, secure cookies
ENVIRONMENT=development

# ---------- Database ----------
# Async database URL (PostgreSQL for production, SQLite for dev)
DATABASE_URL=sqlite+aiosqlite:///./gougealert.db
# Set to "true" to echo all SQL statements (development only!)
DATABASE_ECHO=false

# ---------- Authentication ----------
# JWT signing key (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production

# ---------- CSRF Protection ----------
# CSRF token signing secret (falls back to JWT_SECRET_KEY if not set)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET_KEY=

# ---------- Stripe Payments ----------
# Stripe API secret key (sk_test_... for dev, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_your_key_here
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------- Frontend ----------
# Frontend origin URL (used for CORS allow-origin and redirect URLs)
FRONTEND_URL=http://localhost:3000

# ---------- AI / LLM Providers ----------
# At least one is needed for quote analysis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Email ----------
# Set to "true" to log emails to console instead of sending (development)
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@gougealert.com
FROM_NAME=Ungouge.ai

# ---------- Data Encryption ----------
# Fernet key for encrypting sensitive data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- File Security (Optional) ----------
# VirusTotal API key for malware scanning uploaded files (free tier: 4 req/min)
VIRUSTOTAL_API_KEY=

# ---------- External Data (Optional) ----------
# Bureau of Labor Statistics API key for cost model data
BLS_API_KEY=
