# ==============================================================================
# UnGouge.ai — Production Environment Variables
# ==============================================================================
# Copy this file: cp .env.production.example .env.production
# Fill in ALL required values before deploying.
#
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# ── General ──────────────────────────────────────────────────────────────────
# REQUIRED — Must be "production" for HTTPS redirect, secure cookies, HSTS
ENVIRONMENT=production

# REQUIRED — Frontend URL (used for CORS, Stripe redirects, email links)
FRONTEND_URL=https://gougealert.com

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL async connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Cloud SQL: postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=postgresql+asyncpg://gougealert:CHANGE_ME@localhost:5432/gougealert

# Optional — SQL query logging (MUST be false in production)
DATABASE_ECHO=false

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# REQUIRED — 256-bit secret for signing JWT access/refresh tokens
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️  Changing this invalidates ALL existing user sessions
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE

# ── CSRF Protection ─────────────────────────────────────────────────────────
# REQUIRED — Secret for CSRF token generation/validation
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Falls back to JWT_SECRET_KEY if not set (not recommended)
CSRF_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE

# ── Stripe Payments ──────────────────────────────────────────────────────────
# REQUIRED — Live secret key (starts with sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_CHANGE_ME

# REQUIRED — Live publishable key (starts with pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# REQUIRED — Webhook signing secret (starts with whsec_)
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Webhook URL: https://api.gougealert.com/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# REQUIRED — SMTP server for transactional emails (verification, password reset, MFA)
# Recommended: SendGrid, AWS SES, Mailgun, Postmark
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.CHANGE_ME

# REQUIRED — Must be "false" for production (enables real email delivery)
# When "true", emails are logged to console only (development mode)
EMAIL_DEV_MODE=false

# ── AI / LLM API Keys ───────────────────────────────────────────────────────
# REQUIRED — At least one LLM key for quote analysis
# The analyzer tries OpenAI → Anthropic → Gemini in order

# REQUIRED — OpenAI API key (primary analyzer)
OPENAI_API_KEY=sk-CHANGE_ME

# Optional — Anthropic Claude API key (fallback analyzer)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Optional — Google Gemini API key (fallback analyzer + OCR)
GOOGLE_API_KEY=CHANGE_ME

# ── Encryption (PII at Rest) ─────────────────────────────────────────────────
# REQUIRED — AES-256 key for encrypting PII fields (email, name) in database
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️  Changing this makes existing encrypted data unreadable (key rotation needed)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE

# ── Redis (Rate Limiting) ────────────────────────────────────────────────────
# Optional but RECOMMENDED — Required for rate limiting across multiple instances
# Without Redis, rate limits are per-instance (in-memory) only
# Format: redis://HOST:PORT/DB or redis://:PASSWORD@HOST:PORT/DB
# REDIS_URL=redis://localhost:6379/0

# ── File Security ────────────────────────────────────────────────────────────
# Optional — VirusTotal API key for malware scanning on file uploads
# Get from: https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=CHANGE_ME

# ==============================================================================
# Frontend Environment Variables (set in Vercel/Cloudflare, not in this file)
# ==============================================================================
#
# NEXT_PUBLIC_API_URL=https://api.gougealert.com
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
#
# ==============================================================================
