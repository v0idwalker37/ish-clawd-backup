      </td>
    </tr>
    <tr>
      <td valign="middle" class="td3">
        <p class="p7"><span class="s1">No high-pressure tactics</span></p>
      </td>
      <td valign="middle" class="td4">
        <p class="p8"><span class="s1"></span><br></p>
      </td>
    </tr>
    <tr>
      <td valign="middle" class="td3">
        <p class="p7"><span class="s1">Price within market range</span></p>
      </td>
