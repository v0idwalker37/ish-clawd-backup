      </td>
    </tr>
    <tr>
      <td valign="middle" class="td3">
        <p class="p7"><span class="s1">Permits addressed</span></p>
      </td>
      <td valign="middle" class="td4">
        <p class="p8"><span class="s1"></span><br></p>
      </td>
    </tr>
    <tr>
      <td valign="middle" class="td3">
        <p class="p7"><span class="s1">Reasonable deposit (10-30%)</span></p>
      </td>
      <td valign="middle" class="td4">
        <p class="p8"><span class="s1"></span><br></p>
      </td>
    </tr>
    <tr>
      <td valign="middle" class="td3">
        <p class="p7"><span class="s1">Payment tied to milestones</span></p>
      </td>
