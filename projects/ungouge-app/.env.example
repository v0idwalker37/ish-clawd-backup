# Ungouge.ai Environment Variables
# Copy to .env and fill in values

# ============ Backend ============

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./ungouge.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ungouge

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Email (set EMAIL_DEV_MODE=false in production)
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@ungouge.ai
SMTP_PASSWORD=
FROM_EMAIL=noreply@ungouge.ai
FROM_NAME=Ungouge.ai

# AI Analysis (future - for enhanced explanations)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============ Frontend ============

# API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Site
NEXT_PUBLIC_SITE_URL=https://ungouge.ai
NEXT_PUBLIC_SITE_NAME=Ungouge.ai

# Analytics (future)
# NEXT_PUBLIC_GA_ID=G-...
# NEXT_PUBLIC_HOTJAR_ID=...
