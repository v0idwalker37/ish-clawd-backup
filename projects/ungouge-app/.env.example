# Environment Configuration
# Copy this file to .env and fill in your values

# Environment (development|staging|production)
ENVIRONMENT=development

# Database (PostgreSQL for local dev, MySQL in production)
DATABASE_URL=postgresql+asyncpg://gougealert:devpassword@postgres:5432/gougealert

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-string
CSRF_SECRET_KEY=change-me-to-another-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Service URLs (internal)
COST_MODEL_SERVICE_URL=http://cost-model:8001
QUOTE_EXTRACTOR_SERVICE_URL=http://quote-extractor:8002

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Cloud Platform
GCP_PROJECT_ID=gen-lang-client-0199462206
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Email (for password resets, notifications)
# Using Resend
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@gougealert.com

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn-here

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_QUOTE_UPLOAD=true
ENABLE_PAYMENTS=true
